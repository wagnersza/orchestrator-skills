# Worker checklist files — live in the worktree, torn down with it.
# Also covers /skill-fork-sync eval results, transcripts and benchmarks under
# .orchestrator/fork-sync/<fork>-<candidate-sha>/ — machine-local noise.
.orchestrator/

# Eval sets are the opposite: committed, extended each sync so coverage
# compounds. Nothing under evals/ is ignored — it is listed here only so the
# rule is explicit, since evals/ has no content until the eval-set work item
# lands and git tracks no empty directory.
!evals/
